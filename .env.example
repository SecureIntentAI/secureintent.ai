# PUBLIC BROWSER SETTINGS ONLY. Never add Clerk/Paddle/Brevo secret keys here.
# Copy to .env.staging.local (ignored), replace placeholders, then on Node 22:
# node --env-file=.env.staging.local scripts/prepare-site.mjs
# node scripts/preview-site.mjs
SI_DEPLOY_ENV=staging
SI_STAGING_SITE_ORIGIN=http://127.0.0.1:3002
SI_STAGING_API_BASE=http://127.0.0.1:8787
SI_STAGING_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_DEVELOPMENT_PUBLISHABLE_KEY
SI_STAGING_PADDLE_CLIENT_TOKEN=test_REPLACE_WITH_SANDBOX_CLIENT_TOKEN
SI_STAGING_PADDLE_PRICE_ID=pri_REPLACE_WITH_SANDBOX_PERSONAL_PRICE
# On Netlify use the stable staging HTTPS site/API origins, not loopback.
# The separate sandbox TEAM price belongs in the backend configuration.
